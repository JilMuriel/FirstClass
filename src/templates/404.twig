{% extends "base.twig" %}

{% block content %}
<section class="flex flex-col w-full px-10 firstclass-main-banner section-spacing" {# Background settings #}
	style="background-image: url('{{ site.theme.link }}/images/404.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat;">
	{# Overlay #}
	<div class="overlay" style="background-color: #000; opacity:.4; background-blend-mode: multiply;">
	</div>
	<div
		class="container flex flex-col justify-center w-full h-full px-1 mx-auto mt-auto text-left text-white firstclass-banner-content section-spacing md:w-9/12 lg:w-7/12 xl:w-7/12">
		{# Main title #}
		<h1 class="mb-6 text-lg font-header lg:w-10/12 lg:text-xl">
			Woops... there is an error!</h1>
		{# Subtitle #}
		<h3 class="mb-8 text-lg font-normal leading-relaxed">Sorry, we couldn't find the page that you're looking
			for.</br>Please check url adress or use button to go to the home page!</h3>
		{# Button wrap #}
		<div class="flex flex-col">
			<a href="{{site.link}}" class="mb-6 font-normal btn btn-primary">
				<div class="flex flex-row items-center">
					Home page
				</div>
			</a>
		</div>
	</div>
</section>
{% endblock %}