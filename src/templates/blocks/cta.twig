{#
  Title: CTA
  Description: Call To Action block
  Category: firstclass-blocks
  Icon: table-row-before
  Keywords: offer
  Mode: edit
  Align: left
  PostTypes: page post
  SupportsAlign: left right
  SupportsMode: true
  SupportsMultiple: true
#}
<section class="bg-[#fff] px-[20px] py-[60px] md:py-[90px] lg:py-[120px] pt-0 {{ block.className }}">

  <div class="container mx-auto">
    <div class="relative">
      <!-- Background Overlay -->
      <div class="absolute inset-0 rounded-[8px] bg-center bg-no-repeat bg-cover pointer-events-none hidden md:block lg:block" style="background-image: url('/wp-content/uploads/2026/03/Frame-52629.jpg');"></div>

      <!-- Content -->
      <div class="relative flex flex-col items-center lg:items-start cta-bg h-auto md:h-[577px]">
        <!-- Text -->
        <div class="max-w-[600px] z-30 text-white text-center lg:text-left pt-[60px] px-[20px] lg:p-[70px]">
          <h3 class="font-header font-bold text-[16px] md:text-[18px] mb-6 !leading-none">{{ fields.cta_title }}</h3>
          <h2 class="font-header uppercase font-bold leading-[1.2] text-[28px] md:text-[36px] lg:text-[40px] mb-[30px]">{{ fields.description }}</h2>
          <a href="{{ fields.cta__button.url }}" class="font-bold btn btn-primary">{{ fields.cta__button.title }}</a>
        </div>

        <!-- Image -->
        <div class="bottom-0 right-0 w-full overflow-hidden md:ml-auto lg:absolute md:overflow-visible rounded-br-[8px] pt-0 md:h-auto lg:h-auto">
          <img class="ml-auto sm:block hidden md:block lg:block h-[302px] w-auto md:h-[402px] lg:h-[532px]" src="{{ fields.cta_image.url }}" alt="Mover" />
          <img class="block w-full md:hidden lg:hidden" src="{{ site.theme.link }}/images/uploads/cta-img-block.png}}" />
        </div>
      </div>
    </div>
  </div>
</section>
