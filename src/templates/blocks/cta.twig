{#
  Title: CTA
  Description: Call To Action block
  Category: firstclass-blocks
  Icon: table-row-before
  Keywords: offer
  Mode: edit
  Align: left
  PostTypes: page post
  SupportsAlign: left right
  SupportsMode: true
  SupportsMultiple: true
#}
<section class="bg-[#fff] px-[20px] py-[60px] md:py-[90px] lg:py-[120px] {{ block.className }}">
  <div class="container mx-auto">

    <div class="relative">

      <!-- Background Overlay -->
      <div class="absolute inset-0 rounded-[8px] bg-center bg-no-repeat bg-cover pointer-events-none"
           style="background-image: url('/wp-content/uploads/2026/03/Frame-52629.jpg');">
      </div>

      <!-- Content -->
      <div class="relative flex flex-col items-center lg:items-start">

        <!-- Text -->
        <div class="max-w-[600px] z-30 text-white text-center lg:text-left pt-[60px] px-[20px] lg:p-[70px]">

          <h3 class="font-bold text-[16px] md:text-[18px] mb-[10px] !leading-none">
            {{ fields.cta_title }}
          </h3>

          <h2 class="uppercase font-bold leading-[1.2] text-[28px] md:text-[36px] lg:text-[40px] mb-[30px]">
            {{ fields.description }}
          </h2>

          <a href="{{ fields.cta__button.url }}"
             class="hidden font-bold normal-case md:inline-block btn btn-primary border-2 hover:!bg-transparent hover:!border-white">
            {{ fields.cta__button.title }}
          </a>

        </div>

        <!-- Image -->
        <div class="bottom-0 right-0 block w-full overflow-hidden md:ml-auto lg:absolute md:overflow-visible rounded-br-[8px]">

          <img
            class="hidden ml-auto sm:block h-[302px] w-auto md:h-[402px] lg:h-[532px]"
            src="{{ fields.cta_image.url }}"
            alt="Mover"
          />

          <!-- Mobile Image -->
          <img
            src="{{ fields.cta_image.url }}"
            class="block w-full sm:hidden"
            alt="Mover"
          />

        </div>

      </div>

    </div>

  </div>
</section>