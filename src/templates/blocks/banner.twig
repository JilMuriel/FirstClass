{#
  Title: Banner
  Description: Banner block
  Category: firstclass-blocks
  Icon: money
  Keywords: banner
  Mode: edit
  Align: left
  PostTypes: page post
  SupportsAlign: left right
  SupportsMode: true
  SupportsMultiple: true
#}

{% if fields.banner_version == 'ver1' %}
<section class="bg-custom firstmate-bg firstclass-main-banner home v2 h-full w-full flex flex-col items-center lg:px-10 pb-[32px] md:pb-[70px]" {{ block.className }} {# Background settings#}>
	<article class="md:section-spacing container mx-auto w-full h-full gap-[20px] flex flex-col lg:flex-row items-start justify-between relative z-5 md:mt-auto mb-[10px] md:mb-[90px] !pt-[40px] md:!pt-[80px] lg:!pt-[170px] ">
		<div class="banner-content-block w-full lg:w-[585px] pt-[35px]">
			{% if fields.banner.title or fields.banner.description %}{% endif %}
			{# Main title #}
			{% if fields.banner.title %}
				<h1 class="leading-none text-center mb-[32px] font-bold text-[32px] md:text-left md:text-[65px] text-[#333333]">
					{{fields.banner.title }}</h1>
			{% endif %}
			{# Subtitle #}
			{% if fields.banner.sub_title %}
				<p class="font-body text-[16px] mb-[32px] text-[#4E4D4D] text-center lg:text-left">{{fields.banner.sub_title}}</p>
			{% endif %}
			<div class="flex flex-col gap-[8px]">
				{% for box in fields.banner.services_box_inner %}
				<a href="{{ box.link.url }}" class="service-card flex items-center justify-between p-[24px] rounded-[10px] text-white transition-all duration-300 ease-out transform hover:-translate-y-1 hover:shadow-lg">
					<p class="text-[22px] mb-0 font-bold text-white">
						{{ box.title }}
					</p>
					<div class="flex items-center space-x-2">
						<span>{{ box.link.title }}</span>
						<svg width="24" height="24" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg">
							<path fill-rule="evenodd" clip-rule="evenodd" d="M18.4506 9.37805C16.0529 9.37805 13.8676 7.19372 13.8676 4.79501V3.81152H11.9006V4.79501C11.9006 6.5397 12.6658 8.17622 13.8666 9.37805H1.73145V11.345H13.8666C12.6658 12.5468 11.9006 14.1833 11.9006 15.928V16.9115H13.8676V15.928C13.8676 13.5293 16.0529 11.345 18.4506 11.345H19.4341V9.37805H18.4506Z" fill="white"/>
						</svg>
					</div>
				</a>
				{% endfor %}
			</div>
			{# Button wrap #}
		</div>
		{% if fields.banner.embed_form %}
			<div class="relative w-full placeholder lg:w-[435px]">
				<div class="p-[24px] md:p-[35px] rounded-lg bg-[#B8CEDB] text-[#333333]">
					<p class="font-header font-bold text-[30px] text-center mb-6">Get A Free Estimate</p>
					<div class="custom-form">
						{{fn('do_shortcode', '[brb_collection id=9261]')}}
						<div class="">{{fn('do_shortcode', fields.banner.embed_form)}}</div>
					</div>
				</div>
			</div>
		{% endif %}
	</article>
</section>
{% endif %}






{# –––––––––––––––– BANNER VERSION 1 END –––––––––––––––– #}

{% if fields.banner_version == 'ver2' %}
	<section class="firstclass-main-banner firstmate-bg home v2 h-full w-full flex flex-col items-center lg:px-10 pb-[32px] md:pb-[70px]" {{ block.className }} {# Background settings#} style="background-image: url('wp-content/uploads/2026/03/Banner.jpg'); background-size: cover; background-repeat: no-repeat; background-position: center">
		<article class="firstclass-banner-content md:section-spacing container mx-auto w-full h-full flex flex-col lg:flex-row items-center relative z-5 md:mt-auto mb-[10px] md:mb-[90px] !pt-[40px] md:!pt-[80px] lg:!pt-[170px]">
			<div class="w-full lg:w-7/12">
				{% if fields.banner.title or fields.banner.description %}{% endif %}
				{# Main title #}
				{% if fields.banner.title %}
					<h1 class="leading-none text-center font-bold text-[32px] md:text-left md:text-[65px] text-white">
						{{fields.banner.title }}</h1>
				{% endif %}

				{# Subtitle #}
				{% if fields.banner.sub_title %}
					<p class="font-body text-[16px] mb-4 mt-4 text-white text-center lg:text-left">{{fields.banner.sub_title}}</p>
				{% endif %}

				{# Button wrap #}

			</div>
			{% if fields.banner.embed_form %}
				<div class="relative w-full placeholder lg:w-5/12 lg:pl-12">
					<div class="p-[24px] md:p-[35px] rounded-lg bg-[#D9EAF4D1]/70">
						<p class="font-header font-bold text-[32px] text-center text-dark mb-6">Get A Free Estimate</p>
						{{fn('do_shortcode', '[brb_collection id=9261]')}}
						<div class="">{{fn('do_shortcode', fields.banner.embed_form)}}</div>
					</div>
				</div>
			{% endif %}
		</article>
		<div class="gap-[24px] md:section-spacing container mx-auto w-full h-full flex-col lg:flex-row relative z-5 md:mt-auto flex items-center">
		{% for box in fields.banner.services_box %}
			<a href="{{ box.link.url }}" class="service-mini-card w-full lg:w-4/12 p-[24px] rounded-[10px] text-white transition-all duration-300 ease-out transform hover:-translate-y-1 hover:shadow-lg">
				<p class="text-[22px] mb-[24px] font-bold text-white">
						{{ box.title }}
				</p>
				<p class="text-[16px] mb-[24px] font-normal text-white lg:min-h-[80px]">
						{{ box.description }}
				</p>
				<button class="flex items-center">
					Learn More
					<img decoding="async" src="wp-content/uploads/2026/03/arrow-icon.png" class="h-[24px] w-[24px] ml-[10px]">
				</button>
			</a>
		{% endfor %}

		</div>
	</section>

{% endif %}
{# –––––––––––––––– BANNER VERSION 2 END –––––––––––––––– #}