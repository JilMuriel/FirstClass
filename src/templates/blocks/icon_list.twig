{#
  Title: Icon List
  Description: Icon List Section.
  Category: formatting
  Icon: editor-ul
  Keywords: about
  Mode: edit
  Align: left
  PostTypes: page post
  SupportsAlign: left right
  SupportsMode: true
  SupportsMultiple: true
#}


<section class="bg-[#D9EAF4] px-[20px] py-[60px] md:py-[90px] lg:py-[120px]">
	<div class="container mx-auto text-center md:w-[796px] mb-[40px] lg:mb-[60px]">
		<h2 class="font-header text-[#333] font-bold uppercase mb-[28px] text-[30px] leading-[35px] lg:leading-[55px] md:text-[40px]"> {{ fields.title }}</h2>
		<p class="text-[#4E4D4D] text-[16px] font-regular leading-[28px] mb-0">
			{{ fields.upper_title }}
		</p>
	</div>
	<div class="container grid grid-cols-1 gap-10 px-4 mx-auto sm:grid-cols-2 lg:grid-cols-4 ">
   		{% for box in fields.icon_list %}
			<div class="text-center text-[#333]">
				<div class="mb-[24px] lg:mb-[32px] h-[80px] w-[80px] bg-white rounded-full flex items-center justify-center mx-auto custom-icon-shadow">
					<img src="{{ box.icon.url }}" class="h-[42px] w-auto"/>
				</div>
				<h3 class="font-header leading-[32px] font-bold text-[22px] mb-[18px]">{{ box.title }}</h3>
				<p class="text-[16px] mb-0 sm:max-w-[320px] max-w-[270px] mx-auto text-center lg:mx-0">
				{{ box.description }}
				</p>
			</div>
		{% endfor %}
	</div>
		<a href="{{ fields.button.url}}" class="mt-[40px] lg:mt-[60px] max-w-[190px] block mx-auto font-bold normal-case btn btn-primary text-center items-center">{{ fields.button.title}}
		</a>
</section>


</section>