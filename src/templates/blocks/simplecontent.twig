{#
  Title: Simplecontent
  Description: Simple Content block
  Category: formatting
  Icon: editor-alignleft
  Keywords: about
  Mode: edit
  Align: left
  PostTypes: page post
  SupportsAlign: left right
  SupportsMode: true
  SupportsMultiple: true
#}


<section class="px-[20px] py-[60px] md:py-[90px] lg:py-[100px] {{ block.className }}">
	<article class="container mx-auto">
		<h2 class="text-[#333333] leading-[55px] font-bold md:mb-[30px] text-[30px] md:text-[40px] mb-[30px]">{{ fields.title}}</h2>
		<div class="text-[#4E4D4D] text-[16px] font-regular mb-[30px]">
			{{ fields.description}}
		</div>
			{% if fields.button %}
		<a href="{{ fields.button.url }}" class="mb-4 font-bold normal-case btn bg-blue text-white hover:bg-[#4E4D4D]">{{ fields.button.title }}
			</a>
			{% endif %}
	</article>
</section> 